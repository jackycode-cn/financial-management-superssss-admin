{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "name": "Launch Chrome against localhost",
      "request": "launch",
      "url": "http://localhost:3001",
      "env": { "NODE_ENV": "development" },
      "sourceMaps": true,
      "webRoot": "${workspaceFolder}",
      "runtimeArgs": ["--do-not-de-elevate"]
    }
  ]
}
